### Ran Playwright code
```js
await (async (page) => {
  await page.setViewportSize({width:1440,height:900});
  await page.unrouteAll({behavior:'wait'});
  const errors=[];
  const listener=e=>errors.push(String(e));
  page.on('pageerror',listener);
  let delayed=0, pending=0;
  await page.route('**/api/v1/conversations**',async route=>{
    delayed++; pending++;
    await new Promise(resolve=>setTimeout(resolve,2000));
    await route.continue(); pending--;
  });
  await page.reload({waitUntil:'domcontentloaded'});
  await page.getByRole('heading',{name:'Agent 运行台',exact:true}).waitFor();
  await new Promise(resolve=>setTimeout(resolve,450));
  const initial={stage:'fresh initial null-record loading',pending,delayed,page_errors:[...errors],visible_text:await page.locator('main').innerText()};
  await page.evaluate(proof=>{window.__fourInitialProof=proof},initial);
  await page.screenshot({path:'docs/verification/artifacts/phase11/four-initial-null-record-dark.png'});
  await page.getByRole('heading',{name:'执行过程',exact:true}).waitFor({timeout:20000});
  await new Promise(resolve=>setTimeout(resolve,3000));
  await page.unroute('**/api/v1/conversations**');
  await page.getByRole('menuitem',{name:'知识库',exact:true}).click();
  await page.getByRole('heading',{name:'知识库',exact:true}).waitFor();
  await page.getByRole('menuitem',{name:'Agent 运行台',exact:true}).click();
  await page.getByRole('heading',{name:'执行过程',exact:true}).waitFor();
  await new Promise(resolve=>setTimeout(resolve,700));
  const proof={stage:'initial loading and knowledge return',genuine_get_delayed:delayed,pending_after:pending,page_errors:errors,viewport:await page.evaluate(()=>({width:innerWidth,height:innerHeight,scrollWidth:document.documentElement.scrollWidth})),observability:await page.getByLabel('本轮运行追踪').innerText()};
  await page.evaluate(value=>{window.__fourFinalNavProof=value},proof);
  await page.screenshot({path:'docs/verification/artifacts/phase11/four-return-ready-dark.png'});
  page.off('pageerror',listener);
}
)(page);
```
