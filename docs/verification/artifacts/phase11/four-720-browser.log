### Ran Playwright code
```js
await (async (page)=>{
  await page.getByRole('menuitem',{name:'Agent 运行台',exact:true}).click();
  await page.getByRole('heading',{name:'执行过程',exact:true}).waitFor();
  await page.evaluate(()=>{window.scrollTo(0,0);document.querySelectorAll('*').forEach(el=>{if(el.scrollTop)el.scrollTop=0})});
  await new Promise(resolve=>setTimeout(resolve,700));
  const runtime={viewport:await page.evaluate(()=>({width:innerWidth,height:innerHeight,scrollWidth:document.documentElement.scrollWidth,dark:document.documentElement.classList.contains('dark')})),trace:await page.getByRole('link',{name:'打开本轮 Langfuse 追踪 ↗',exact:true}).boundingBox(),back_button:await page.getByRole('button',{name:'返回邮件',exact:true}).boundingBox()};
  await page.screenshot({path:'docs/verification/artifacts/phase11/four-runtime-dark-1280x720.png'});
  await page.evaluate(value=>{window.__four720.runtime=value},runtime);
}
)(page);
```
