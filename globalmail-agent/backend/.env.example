# Server-only environment; actual values are injected by scripts/start-local.ps1.
GLOBALMAIL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:15432/globalmail
GLOBALMAIL_OBJECT_ROOT=.local-data/objects
GLOBALMAIL_ALLOWED_ORIGINS=http://127.0.0.1:15173,http://localhost:15173
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Optional server-only embedding credentials; blank values fall back to LLM_API_KEY/LLM_BASE_URL.
# Supported Beijing compatible endpoint; profiles fix qwen3.7-text-embedding/text-embedding-v4 at 1024 dimensions.
GLOBALMAIL_EMBEDDING_API_KEY=
GLOBALMAIL_EMBEDDING_BASE_URL=
# Optional private local observability; loaded from .local-data/observability/backend.env.
GLOBALMAIL_LANGFUSE_ENABLED=false
GLOBALMAIL_LANGFUSE_BASE_URL=http://127.0.0.1:3001
GLOBALMAIL_LANGFUSE_PUBLIC_KEY=
GLOBALMAIL_LANGFUSE_SECRET_KEY=
GLOBALMAIL_LANGFUSE_PROJECT_ID=globalmail-agent-local
