# 本地开发示例；复制为 .env 后使用。Agent 后端尚未实现。
# VITE_ 变量会进入浏览器，不得填写模型 API Key 或其他服务端密钥。
VITE_VERSION=0.0.0
VITE_PORT=3000
VITE_BASE_URL=/
VITE_ACCESS_MODE=frontend
VITE_WITH_CREDENTIALS=false
VITE_OPEN_ROUTE_INFO=false
VITE_API_URL=/
VITE_API_PROXY_URL=http://127.0.0.1:8000
VITE_DROP_CONSOLE=false
# 模板锁屏功能的公开演示占位值；不是认证能力，后续按单用户范围裁剪。
VITE_LOCK_ENCRYPT_KEY=demo-public-lock-key
